{
  "name": "dsh-hud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "meta": {
    "title": "DSH HUD",
    "description": "输入框下方的 HUD 行：🤖 agent / ⚓ hook / ✦ skill 三胶囊，点击弹详情（会话投影驱动，按 session 独立统计）"
  },
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
